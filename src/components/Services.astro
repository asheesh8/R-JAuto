---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Art from './Art.astro';
import { company } from '@/data/business';
import { MONTHS, type ServiceView } from '@/lib/content';
import fallback from '@/assets/photos/garage-bay-dusk.jpg';

export interface Props { services: ServiceView[] }
const { services } = Astro.props;

// One photo per built-in service; anything John adds in the admin gets the
// shop-at-dusk photo until it has its own.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/services/*.jpg', { eager: true });
const photoFor = (id: string) => photos[`/src/assets/photos/services/${id}.jpg`]?.default ?? fallback;

const tag = (s: ServiceView) => {
  if (s.status === 'seasonal') return s.bookable ? `Seasonal, ${MONTHS[s.seasonStart - 1]} to ${MONTHS[s.seasonEnd - 1]}` : `Closed for the season. Back in ${MONTHS[s.seasonStart - 1]}`;
  if (s.status === 'paused') return 'Not booking right now';
  return '';
};
---

<section class="section svc" id="services" aria-labelledby="svc-h">
  <Art name="piston" class="hide-sm" style="--w: 150px; --r: 14deg; --o: 0.1; --right: -40px; --top: 34%;" />
  <Art name="maple" style="--w: 96px; --r: 18deg; --o: 0.14; --right: 4%; --top: 56px; --w-sm: 64px; --top-sm: 44px; --right-sm: 18px; --o-sm: 0.2;" />
  <Art name="maple" class="hide-sm" style="--w: 130px; --r: -32deg; --o: 0.1; --left: -28px; --bottom: 3%;" />
  <Art name="coilover" class="hide-sm" style="--w: 84px; --r: -10deg; --o: 0.12; --left: 3%; --bottom: 6%;" />
  <Art name="belt" class="hide-sm" style="--w: 280px; --o: 0.12; --right: 9%; --top: 28px;" />
  <div class="wrap svc__grid">
    <div class="svc__intro">
      <h2 class="h-section" id="svc-h" data-reveal>What we fix</h2>
      <p class="lede" data-reveal style="--d:60ms">
        The work that comes through the bay most. Not on the list? Call and ask.
      </p>
      <a class="link" href={`tel:${company.phoneRaw}`} data-reveal style="--d:120ms"><Icon name="phone" /> {company.phone}</a>
    </div>

    <ul class="svc__list">
      {services.map((s) => (
        <li class:list={['row', { 'row--off': !s.bookable }]} id={`svc-${s.id}`} data-reveal>
          <div class="row__text">
            {tag(s) && <p class:list={['row__tag', { off: !s.bookable }]}>{tag(s)}</p>}
            <h3 class="row__name">{s.name}</h3>
            <p class="row__blurb">{s.blurb}</p>
            {!s.bookable && s.note && <p class="row__note">{s.note}</p>}
            {s.items.length > 0 && <p class="row__items">{s.items.join(', ')}</p>}
          </div>
          <div class="row__photo photo">
            <Image src={photoFor(s.id)} alt="" widths={[240, 480, 640]} sizes="(max-width: 620px) 82vw, 120px" loading="lazy" />
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc { overflow: hidden; }
  .svc__grid { position: relative; z-index: 1; display: grid; gap: 36px; }
  .svc__intro { display: grid; gap: 14px; justify-items: start; max-width: 640px; }

  /* Desktop: three compact columns, thumbnail beside the text. */
  .svc__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 30px 36px;
  }
  .row { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; align-items: start; }
  .row__photo { order: -1; aspect-ratio: 1; }
  .row__text { display: grid; gap: 5px; padding-top: 2px; }
  .row__tag { font-size: var(--t-xs); font-weight: 750; color: var(--green); }
  .row__tag.off { color: var(--ink-3); }
  .row__name { font-size: var(--t-lg); line-height: 1.2; letter-spacing: -0.01em; }
  .row__blurb { font-size: var(--t-sm); line-height: 1.5; color: var(--ink-2); }
  .row__note { font-size: var(--t-xs); color: var(--ink-2); font-style: italic; }
  .row__items { display: none; }
  .row--off .row__photo img { filter: grayscale(1) contrast(0.9); opacity: 0.75; }
  /* Landing here from a hero tile: mark the one they asked about. */
  .row:target .row__photo { box-shadow: 0 0 0 3px var(--paper), 0 0 0 5px var(--green); }
  .row:target .row__name { color: var(--green); }

  @media (max-width: 1100px) {
    .svc__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  /* Phones: a swipeable row of cards. */
  @media (max-width: 620px) {
    .svc__grid { gap: 28px; }
    .svc__list {
      display: grid;
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 12px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(var(--gutter) * -1);
      padding: 4px var(--gutter) 12px;
      scrollbar-width: none;
    }
    .svc__list::-webkit-scrollbar { display: none; }
    .row {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0 0 18px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--card);
      scroll-snap-align: start;
      overflow: hidden;
    }
    .row__photo { aspect-ratio: 4 / 3; border-radius: 0; }
    .row__text { padding: 16px 16px 0; }
    .row__name { font-size: var(--t-xl); }
    .row__blurb { font-size: var(--t-base); }
  }
</style>
