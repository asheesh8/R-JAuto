---
/**
 * R&J as a Vermont vanity plate: green field, white border, "VERMONT" across
 * the top. A stand-in until we see the shop's sign. TODO(rj): ask John if
 * there is an existing logo.
 */
export interface Props { class?: string }
const { class: cls } = Astro.props;
---
<span class:list={['logo', cls]}>
  <span class="logo__plate" aria-hidden="true">
    <span class="logo__state">Vermont</span>
    <span class="logo__tag">R&amp;J</span>
  </span>
  <span class="logo__name">R&amp;J Auto Service</span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; }
  .logo__plate {
    display: grid;
    justify-items: center;
    width: 64px;
    padding: 3px 0 2px;
    border-radius: 5px;
    background: #1d5236;
    color: #f3f6f4;
    box-shadow: inset 0 0 0 2px #1d5236, inset 0 0 0 3.5px #f3f6f4;
    line-height: 1;
  }
  .logo__state { font-size: 6.5px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; margin-top: 3px; }
  .logo__tag { font-size: 19px; font-weight: 850; letter-spacing: 0.02em; margin-top: 1px; }
  .logo__name { font-size: 17px; font-weight: 800; letter-spacing: -0.01em; white-space: nowrap; }
</style>
