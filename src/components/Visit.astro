---
import Icon from './Icon.astro';
import Art from './Art.astro';
import { company, DAY_LABELS, DAY_ORDER } from '@/data/business';
import { fmtTime, openState, shopClock, type SiteContent } from '@/lib/content';

export interface Props { content: SiteContent }
const { content } = Astro.props;
const clock = shopClock();
const state = openState(content.hours);
---

<section class="section visit" id="visit" aria-labelledby="visit-h">
  <Art name="bridge" style="--w: 380px; --o: 0.1; --left: -40px; --bottom: 18px; --w-sm: 190px; --left-sm: auto; --right-sm: -30px; --bottom-sm: auto; --top-sm: 34px; --o-sm: 0.12;" />
  <div class="wrap visit__grid">
    <div class="visit__where">
      <div class="sign" aria-hidden="true" data-reveal>
        <span class="sign__num">460</span>
        <span class="sign__name">N Main St</span>
      </div>
      <h2 class="h-section" id="visit-h" data-reveal style="--d:60ms">Come by the shop.</h2>
      <address data-reveal style="--d:100ms">{company.streetLong}<br />{company.city}, {company.stateLong} {company.zip}</address>
      <p class="visit__tow" data-reveal style="--d:140ms">Getting towed in? Have it brought here and call so {company.contact} knows it's coming.</p>
      <div class="visit__cta" data-reveal style="--d:180ms">
        <a class="btn" href={`tel:${company.phoneRaw}`} aria-label={`Call ${company.phone}`}><Icon name="phone" weight="fill" /> <span class="num">{company.phone}</span></a>
        <a class="btn btn--line" href={company.directionsUrl} target="_blank" rel="noopener"><Icon name="navigation-arrow" /> Directions</a>
      </div>
    </div>

    <div class="visit__hours" data-reveal style="--d:120ms">
      <h3>Hours</h3>
      <p class="status" data-open={String(state.open)}>{state.label}</p>
      <table>
        <tbody>
          {DAY_ORDER.map((d) => {
            const h = content.hours[d];
            return (
              <tr class:list={{ today: d === clock.dayKey }}>
                <th scope="row">{DAY_LABELS[d]}</th>
                <td class="num">{h.closed ? 'Closed' : `${fmtTime(h.open)} to ${fmtTime(h.close)}`}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
      {content.hoursNote && <p class="visit__note">{content.hoursNote}</p>}
    </div>

    <div class="visit__map photo" data-reveal style="--d:160ms">
      <iframe
        title={`Map to ${company.name}`}
        src={company.mapsEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<style>
  .visit { overflow: hidden; }
  .visit__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.8fr 1.1fr;
    gap: clamp(28px, 4vw, 56px);
    align-items: start;
  }
  .visit__where { display: grid; gap: 18px; justify-items: start; }
  /* A green MUTCD street-name sign, the real thing on every corner in Barre. */
  .sign {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 10px 18px 6px;
    border-radius: 6px;
    background: #1d6b45;
    color: #fff;
    box-shadow: inset 0 0 0 3px #1d6b45, inset 0 0 0 5px #fff, 0 10px 20px -12px rgb(18 22 20 / 0.5);
    line-height: 1;
  }
  .sign__num { font-size: 15px; font-weight: 700; }
  .sign__name { font-size: 30px; font-weight: 700; letter-spacing: 0.01em; }
  address { font-style: normal; font-size: var(--t-lg); line-height: 1.45; }
  .visit__tow { color: var(--ink-2); max-width: 26em; }
  /* Side by side when the column allows, otherwise two full-width buttons. */
  .visit__cta { justify-self: stretch; max-width: 420px; display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }
  .visit__cta .btn { flex: 1 1 auto; }

  .visit__hours { padding: 24px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .visit__hours h3 { font-size: var(--t-xl); letter-spacing: -0.015em; }
  .visit__hours .status { margin-top: 8px; font-size: var(--t-sm); }
  table { width: 100%; margin-top: 16px; border-collapse: collapse; font-size: var(--t-sm); }
  th, td { padding: 7px 0 5px; text-align: left; font-weight: 500; }
  td { text-align: right; color: var(--ink-2); }
  tr.today th, tr.today td { font-weight: 800; color: var(--ink); }
  .visit__note { margin-top: 12px; font-size: var(--t-sm); color: var(--ink-2); }

  .visit__map { aspect-ratio: 4 / 5; border: 1px solid var(--line); }
  .visit__map iframe { width: 100%; height: 100%; border: 0; filter: saturate(0.6); }

  @media (max-width: 1000px) {
    .visit__grid { grid-template-columns: 1fr 1fr; }
    .visit__map { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  }
  /* The sticky bar already carries Call and Directions on phones. */
  @media (max-width: 720px) {
    .visit__cta { display: none; }
  }
  @media (max-width: 640px) {
    .visit__grid { grid-template-columns: 1fr; gap: 24px; }
    /* Phones: the sticky bar's Directions button does the map's job. */
    .visit__map { display: none; }
  }
</style>
