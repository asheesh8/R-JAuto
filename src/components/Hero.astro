---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import Art from './Art.astro';
import { company, rating } from '@/data/business';
import { reviews } from '@/data/reviews';
import { openState, viewServices, type SiteContent } from '@/lib/content';
import fallback from '@/assets/photos/garage-bay-dusk.jpg';
import brakeJob from '@/assets/photos/services/brakes.jpg';

export interface Props { content: SiteContent }
const { content } = Astro.props;
const saturday = !content.hours.sat.closed;
const state = openState(content.hours);

// Four quick links into the service list, following whatever is bookable in
// the admin. Brakes leads because it is the part spinning beside them.
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/services/*.jpg', { eager: true });
const photoFor = (id: string) => photos[`/src/assets/photos/services/${id}.jpg`]?.default ?? fallback;
const bookable = viewServices(content.services).filter((s) => s.bookable);
const preferred = ['brakes', 'belts', 'cooling', 'repairs'];
const quick = [
  ...preferred.map((id) => bookable.find((s) => s.id === id)).filter((s) => !!s),
  ...bookable.filter((s) => !preferred.includes(s.id)),
].slice(0, 4);

const pull = reviews.find((r) => r.name === 'Marcus N')!;
---

<div class="brk" data-brake-track>
  <canvas class="brk__canvas" data-brake aria-hidden="true"></canvas>
  <Art name="brake" class="hide-sm" style="--w: min(50vw, 720px); --o: 0.12; --top: calc(48svh - min(14vw, 200px)); --right: 2%;" />
  <Art name="sparkplug" class="hide-sm" style="--w: 64px; --r: 16deg; --o: 0.22; --top: 9%; --left: 44%;" />
  <Art name="wrench" class="hide-sm" style="--w: 300px; --r: -16deg; --o: 0.09; --top: 70svh; --left: -90px;" />
  <Art name="tire" style="--w: 360px; --r: 8deg; --o: 0.07; --bottom: 4%; --left: 30%; --w-sm: 220px; --bottom-sm: 1%; --left-sm: auto; --right-sm: -80px; --o-sm: 0.08;" />

  <!-- Phones open on a real-looking brake job; the 3D brake moves down to the brakes copy. -->
  <div class="hero__photo">
    <Image src={brakeJob} alt="Front brake job on a car up on a lift: old rotor on the hub, new rotor beside it" widths={[480, 820]} sizes="(max-width: 900px) 100vw, 480px" loading="eager" fetchpriority="high" />
  </div>

  <div class="hero__aside" aria-label="From the shop">
    <figure class="float float--review" data-reveal style="--d:300ms">
      <p class="float__rate">
        <span class="float__stars" aria-hidden="true">{Array.from({ length: 5 }).map(() => <Icon name="star" weight="fill" size={14} />)}</span>
        <span><strong class="num">{rating.value}</strong> on Google, {rating.count} reviews</span>
      </p>
      <blockquote>“{pull.quote}”</blockquote>
      <figcaption>{pull.name}, Google review</figcaption>
    </figure>
    <div class="float float--tow" data-reveal style="--d:420ms">
      <span class="float__icon"><Icon name="map-pin" weight="fill" size={18} /></span>
      <p><strong>Broke down nearby?</strong> Have it towed to {company.street} and call ahead.</p>
    </div>
  </div>

  <section class="hero" aria-labelledby="hero-h">
    <div class="wrap">
      <div class="hero__copy">
        <p class="hero__meta" data-reveal>
          <span class="status" data-open={String(state.open)}>{state.label}</span>
          <span class="hero__addr">{company.street}, {company.city}</span>
        </p>
        <h1 class="h-display" id="hero-h" data-reveal style="--d:40ms">The good guys on North&nbsp;Main.</h1>
        <p class="lede hero__lede" data-reveal style="--d:80ms">
          Same-day when there's room in the bay, fair quotes{saturday ? ', and Saturday hours' : ''}. Ask for {company.contact}.
        </p>
        <div class="hero__cta" data-reveal style="--d:160ms">
          <a class="btn hero__call" href={`tel:${company.phoneRaw}`}><Icon name="phone" weight="fill" /> Call<span class="num hero__num">&nbsp;{company.phone}</span></a>
          <a class="btn btn--line" href="#services">See services <Icon name="arrow-right" /></a>
        </div>
        {quick.length > 0 && (
          <nav class="quick" aria-label="Popular services" data-reveal style="--d:220ms">
            <p class="quick__label">Most asked about</p>
            <ul>
              {quick.map((s) => (
                <li>
                  <a href="#services">
                    <Image src={photoFor(s.id)} alt="" widths={[96, 160]} sizes="52px" class="quick__img" />
                    <span class="quick__name">{s.name}</span>
                    <Icon name="arrow-right" size={14} class="quick__go" />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>
  </section>

  <section class="brakes" aria-labelledby="brakes-h">
    <div class="wrap">
      <div class="brakes__copy">
        <h2 class="h-section" id="brakes-h" data-reveal>Salt is hard on brakes.</h2>
        <p class="lede" data-reveal style="--d:80ms">
          Vermont winters eat pads, rotors, calipers and lines. You hear what's worn, what isn't, and what it costs
          before anything gets replaced.
        </p>
        <blockquote class="brakes__quote" data-reveal style="--d:160ms">
          <p>“Reasonably priced, competent, and ethical.”</p>
          <footer>Martin Beaudin, Google review</footer>
        </blockquote>
      </div>
    </div>
  </section>
</div>

<script>
  const track = document.querySelector<HTMLElement>('[data-brake-track]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-brake]');
  if (canvas && track) {
    const start = () =>
      import('@/scripts/brake-hero').then(({ mountBrake }) => mountBrake(canvas, track)).catch(() => canvas.remove());
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 500 });
    else setTimeout(start, 150);
  }
</script>

<style>
  /* One grid: the two text blocks span the full width, the canvas pins to the
     right column across both rows and stays inside them. */
  .brk {
    position: relative;
    /* clip, not hidden: hidden would make this a scroll box and break the sticky canvas. */
    overflow-x: clip;
    display: grid;
    grid-template-columns: 44% 56%;
    background:
      radial-gradient(60% 50% at 78% 30%, #ffffff 0%, transparent 70%),
      var(--paper);
  }
  .brk > section { grid-column: 1 / -1; }
  .hero { grid-row: 1; }
  .brakes { grid-row: 2; }
  .brk__canvas {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: start;
    position: sticky;
    top: var(--header-h);
    width: 100%;
    height: calc(100svh - var(--header-h));
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .brk__canvas[data-ready] { opacity: 1; }
  /* A lift pad for the brake to sit on: a soft plate-green disc with one ring. */
  .brk__canvas {
    background:
      radial-gradient(circle closest-side at 50% 50%, transparent 0 86%, rgb(29 82 54 / 0.18) 86.2% 86.8%, transparent 87%),
      radial-gradient(circle closest-side at 50% 50%, #e1ebe4 0 74%, rgb(225 235 228 / 0) 74.5%);
  }

  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    align-items: center;
    padding-block: 28px 40px;
  }
  .hero__copy { position: relative; z-index: 2; max-width: 560px; }
  .hero__meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin-bottom: 22px;
    padding: 8px 14px 6px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--line), 0 6px 16px -10px rgb(18 22 20 / 0.25);
    font-size: var(--t-sm);
  }
  .hero__meta .status { font-weight: 700; }
  .hero__addr { color: var(--ink-3); padding-left: 14px; border-left: 1px solid var(--line-2); }
  .hero__lede { margin-top: 22px; max-width: 30em; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

  /* Popular services: real photos and real links where the page was blank. */
  .quick { margin-top: 34px; }
  .quick__label { font-size: var(--t-xs); font-weight: 700; color: var(--ink-3); margin-bottom: 10px; }
  .quick ul { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 520px; }
  .quick a {
    display: grid;
    grid-template-columns: 52px 1fr auto;
    align-items: center;
    gap: 12px;
    padding: 7px 12px 7px 7px;
    border-radius: var(--radius);
    background: #fff;
    box-shadow: 0 0 0 1px var(--line), 0 8px 18px -14px rgb(18 22 20 / 0.35);
    text-decoration: none;
    transition: box-shadow 180ms ease, transform 180ms var(--ease-out);
  }
  .quick a:hover { box-shadow: 0 0 0 1.5px var(--green), 0 10px 22px -14px rgb(18 22 20 / 0.4); transform: translateY(-1px); }
  .quick :global(.quick__img) { width: 52px; height: 52px; border-radius: 4px; object-fit: cover; }
  .quick__name { font-size: var(--t-sm); font-weight: 750; line-height: 1.2; padding-top: 2px; }
  .quick :global(.quick__go) { color: var(--green); }

  /* Cards pinned over the brake, in the hero row only. */
  .hero__aside {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    z-index: 3;
    pointer-events: none;
  }
  .float {
    position: absolute;
    margin: 0;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--line), 0 18px 36px -18px rgb(18 22 20 / 0.35);
    pointer-events: auto;
  }
  .float--review { top: 9%; left: 3%; width: 240px; padding: 14px 16px 12px; }
  .float__rate { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; font-size: var(--t-xs); color: var(--ink-2); }
  .float__rate strong { color: var(--ink); font-weight: 800; }
  .float__stars { display: inline-flex; gap: 1px; color: #e3a008; }
  .float--review blockquote { margin: 8px 0 0; font-size: var(--t-lg); line-height: 1.25; font-weight: 750; letter-spacing: -0.01em; }
  .float--review figcaption { margin-top: 6px; font-size: var(--t-xs); color: var(--ink-3); }
  .float--tow { bottom: 9%; right: 4%; width: 270px; display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: start; padding: 14px 16px 12px; font-size: var(--t-sm); line-height: 1.45; color: var(--ink-2); }
  .float--tow strong { display: block; color: var(--ink); font-weight: 800; }
  .float__icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--green-tint); color: var(--green); }
  .hero__photo { display: none; }

  .brakes {
    position: relative;
    min-height: 88svh;
    display: flex;
    align-items: center;
    padding-block: 40px 120px;
  }
  .brakes__copy { position: relative; z-index: 2; max-width: 470px; }
  .brakes .lede { margin-top: 20px; }
  .brakes__quote { margin: 32px 0 0; padding-left: 18px; border-left: 3px solid var(--green); }
  .brakes__quote p { font-size: var(--t-xl); line-height: 1.3; font-weight: 650; letter-spacing: -0.01em; }
  .brakes__quote footer { margin-top: 8px; font-size: var(--t-sm); color: var(--ink-3); }

  @media (max-width: 900px) {
    .brk { grid-template-columns: 1fr; }
    .brk__canvas {
      grid-column: 1;
      grid-row: 1;
      position: relative;
      top: 0;
      height: 42svh;
      min-height: 270px;
    }
    /* Rows on phones: photo, pitch, 3D brake, brakes copy. */
    .hero__photo {
      display: block;
      grid-column: 1;
      grid-row: 1;
      margin: 14px var(--gutter) 0;
      aspect-ratio: 4 / 3;
      border-radius: 10px;
      overflow: hidden;
      box-shadow: 0 18px 36px -24px rgb(18 22 20 / 0.55);
    }
    .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 40% 50%; }
    .hero { grid-row: 2; }
    .brk__canvas { grid-row: 3; }
    .brakes { grid-row: 4; }
    .hero { min-height: 0; padding-block: 34px 36px; }
    .hero__aside { grid-column: 1; grid-row: 1; }
    .float--review { top: auto; left: auto; bottom: -20px; right: calc(var(--gutter) + 10px); width: 200px; padding: 9px 11px 8px; }
    .float__rate { font-size: 12px; gap: 2px 6px; }
    .float--review blockquote { font-size: var(--t-sm); line-height: 1.25; margin-top: 4px; }
    .float--review figcaption { font-size: 11.5px; margin-top: 3px; }
    .float--tow { display: none; }
    .brakes { min-height: 0; padding-block: 8px 64px; }
    .hero__meta { margin-bottom: 16px; }
  }
  /* The sticky call bar takes over on phones, so the hero keeps one button. */
  /* Phones: the sticky bar has Call, and the service tiles below replace
     "See services", so the hero goes straight from the pitch to the tiles. */
  @media (max-width: 720px) {
    .hero__cta { display: none; }
    .quick { margin-top: 24px; }
  }
  @media (max-width: 440px) {
    .quick a { grid-template-columns: 40px 1fr; gap: 9px; }
    .quick :global(.quick__img) { width: 40px; height: 40px; }
    .quick :global(.quick__go) { display: none; }
  }
  @media (max-width: 440px) {
    .hero__addr { display: none; }
  }
</style>
